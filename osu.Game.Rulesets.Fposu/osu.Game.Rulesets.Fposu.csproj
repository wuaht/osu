    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>osu! in first person, for aim training. Based on McOsu's FPoSu.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Title>FPoSu (ruleset)</Title>
